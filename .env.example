# Required only to initialize a NEW data volume. No default password is shipped.
# Use at least 12 characters; keep this file private after copying it to .env.
ROOT_PASSWORD=
HOST_BIND=127.0.0.1
WEB_PORT=8080
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# For LAN use HOST_BIND=0.0.0.0 and add the exact http://YOUR_LAN_IP:8080 origin above.
# Configure Ollama URL/model in /admin. From game container to optional service: http://ollama:11434.

# Player accounts: registration never logs in automatically.
PLAYER_REGISTRATION_ENABLED=true
PLAYER_SESSION_HOURS=12
# Set true when the public URL uses HTTPS (including TLS at a reverse proxy).
PLAYER_COOKIE_SECURE=false

# Built-in Postfix utility: no external SMTP account or owned DNS domain.
# scripts/correo.sh configurar detects the public IPv4 and fills these values.
# The default stays disabled until a usable sending IP is configured.
MAIL_ENABLED=false
MAIL_PUBLIC_IP=
MAIL_FROM=
APP_PUBLIC_URL=http://localhost:8080
PASSWORD_RESET_MINUTES=30
MAIL_NETWORK_SUBNET=172.30.42.0/28
